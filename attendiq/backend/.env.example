# Neon connection string (Dashboard -> Connection Details, pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
# Shared secret the ESP32 sends as the x-device-key header
DEVICE_API_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
# Minimum attendance percentage students must keep (default 75)
ATTENDANCE_THRESHOLD=75
# AI assistant (Groq). Leave the placeholder to use the built-in rule-based assistant.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: connection string for a Postgres role with SELECT-only grants, used for the
# assistant's SQL tool (see README). Falls back to DATABASE_URL inside READ ONLY transactions.
ASSISTANT_DATABASE_URL=
# Max assistant questions per student per minute
ASSISTANT_RATE_LIMIT=15
